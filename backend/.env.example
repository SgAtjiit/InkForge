# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Connection (Neon PostgreSQL)
DB_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/inkforge?sslmode=require

# Admin Seed Credentials
ADMIN_EMAIL=admin@inkforge.dev
ADMIN_PASSWORD=AdminPass123

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_min_32_chars
JWT_REFRESH_EXPIRY=7d

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# OpenRouter AI Moderation
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Transactional Email Service (Resend / SendGrid - Optional)
RESEND_API_KEY=re_your_resend_api_key_here
